# ──────────────────────────────────────────────────────────────────────────────
# PG Forge — environment variables
# ──────────────────────────────────────────────────────────────────────────────
# Every variable read by the server lives here. Required entries at the top;
# optional ones grouped by feature further down with their defaults shown.
#
# Secrets generation tips:
#   JWT_SECRET                  openssl rand -base64 32
#   SECRETS_KEY (64 hex chars)  openssl rand -hex 32
#   POSTGRES_SUPERUSER_PASSWORD openssl rand -hex 32
#   REDIS_PASSWORD              openssl rand -hex 32   (must be URL-safe — hex only)
#   MINIO_ROOT_PASSWORD         openssl rand -base64 32
#
# Prefer scripts/deploy.sh for a fresh install — it generates all of the above.
# ──────────────────────────────────────────────────────────────────────────────


# ─── Required ────────────────────────────────────────────────────────────────

# Domain for Caddy auto-HTTPS. Caddy issues a wildcard cert via DNS-01 and
# on-demand certs for any custom domain attached to an app.
DOMAIN=forge.example.com

# Optional: a second, separate apex for the apps of every org except the
# default one, so tenant code never runs under DOMAIN (cookie isolation).
# Empty = every app on <name>.DOMAIN, as before. Needs *.<it> DNS pointing
# here and, for DNS-01, the same provider token as DOMAIN. Never serve the
# dashboard on it; see CLAUDE.md "Tenant apps domain" and
# docs/runbooks/public-suffix-list.md.
# TENANT_APPS_DOMAIN=apps.example.net

# Optional: send Content-Security-Policy "sandbox" + nosniff on s3.DOMAIN, so
# tenant-uploaded HTML served by a presigned URL can't run script (and set
# cookies) on DOMAIN. Set true on installs hosting untrusted tenants. Costs:
# a PDF opened directly from s3.DOMAIN may not render in Chrome's viewer, and
# JS/CSS objects stored with a wrong Content-Type stop loading.
# S3_CONTENT_SANDBOX=false

# Web UI login password (single-admin mode).
ADMIN_PASSWORD=changeme

# JWT signing secret. Min 32 chars.
JWT_SECRET=replace-with-a-long-random-string

# Rotation window only: the PREVIOUS JWT_SECRET. While set, tokens signed with
# it still verify (new tokens are always signed with JWT_SECRET). Clear it once
# the old tokens have expired — 8h. See docs/runbooks/rotating-secrets.md.
JWT_SECRET_PREVIOUS=

# Optional: pin a provisioned Kratos instance to back Forge's own login.
# Leave empty: Forge auto-provisions and adopts the reserved "forge-auth"
# Kratos project on first boot (and on any install where it is missing).
# ADMIN_PASSWORD still works as a break-glass fallback if Kratos is unreachable.
# On first boot Forge seeds an identity (FORGE_AUTH_ADMIN_EMAIL + ADMIN_PASSWORD).
FORGE_AUTH_KRATOS_ID=
FORGE_AUTH_ADMIN_EMAIL=admin@localhost
# Set to true to enable the public self-service signup endpoint
# (POST /api/auth/signup). Defaults to false as of 2026-08 — self-service
# tenant creation is opt-in; single-admin installs need not set this.
FORGE_AUTH_SIGNUP_ENABLED=false

# When true, a fresh signup gets no session/org until the emailed 6-digit
# code is verified (POST /api/auth/verify). Defaults to false. See CLAUDE.md
# "Self-serve signup" D1.
FORGE_AUTH_REQUIRE_VERIFIED_EMAIL=false

# D3 signup bot protection, all independently opt-in (see CLAUDE.md
# "Self-serve signup" D3). All three of provider/secret/site-key must be set
# together or captcha is treated as disabled.
SIGNUP_CAPTCHA_PROVIDER=
SIGNUP_CAPTCHA_SECRET=
SIGNUP_CAPTCHA_SITE_KEY=
SIGNUP_BLOCK_DISPOSABLE=false
# Comma-separated extra domains to block, on top of the embedded list.
SIGNUP_BLOCKED_DOMAINS=

# When true, a self-serve signup org is created with no compute quota — every
# deploy/start 409s ("add a payment method") until a platform admin flips it
# on via `pgforge org payment-method <id> --on-file`. Defaults to false.
SIGNUP_REQUIRE_PAYMENT_METHOD=false

# D4: require accepting ToS/AUP/privacy at signup (and invite-accept).
# Empty version = off — an install that hasn't set this signs up exactly as
# before. See CLAUDE.md "Self-serve signup" D4.
SIGNUP_TERMS_VERSION=
SIGNUP_TERMS_URL=
SIGNUP_AUP_URL=
SIGNUP_PRIVACY_URL=

# AES-256-GCM key for encrypting app secrets at rest.
# 64 hex characters (`openssl rand -hex 32`), which Forge hex-decodes to the
# full 32-byte AES-256 key. A bare 32-character string is still accepted for
# backwards compatibility, but it is used as 32 raw bytes — so a 32-char hex
# value carries only 128 bits of entropy. Prefer the 64-hex form.
# Changing this value strands every vaulted secret — rotate it with
# `pgforge rotate-secrets-key --old-key <previous>`, see
# docs/runbooks/rotating-secrets.md.
SECRETS_KEY=replace-with-64-char-hex-string

# Multitenancy RLS backstop: password for the non-superuser `forge_app`
# Postgres role. Read requests are served through this role inside a
# transaction that sets app.current_org, so the row-level-security
# org_isolation policies apply — the main pool connects as a superuser and
# PostgreSQL lets superusers bypass FORCE ROW LEVEL SECURITY. Forge creates
# and grants the role automatically at startup; just set a password here.
#   FORGE_APP_DB_PASSWORD       openssl rand -hex 24
# Leave empty to disable the backstop (org isolation then relies on
# application-layer filtering alone).
FORGE_APP_DB_PASSWORD=

# How many orgs one identity may own (orgs.Create). Each org has its own
# free-tier quota, so this is what stops one user multiplying it; membership
# in any number of orgs is not capped. Default 1.
# MAX_OWNED_ORGS_PER_IDENTITY=1

# PostgreSQL superuser password (referenced by MASTER_PG_URL and the Postgres service).
# REQUIRED — compose fails fast (:?) if unset; never ship the old :-superpassword default.
POSTGRES_SUPERUSER_PASSWORD=replace-with-pg-password

# PostgreSQL superuser connection string (used for provisioning).
MASTER_PG_URL=postgresql://postgres:${POSTGRES_SUPERUSER_PASSWORD}@postgres:5432/postgres

# Redis password. MUST be URL-safe — it gets embedded in redis:// userinfo.
# Use hex; base64 characters (/ + =) break url.Parse on the Go side.
REDIS_PASSWORD=replace-with-hex-redis-password
# Redis backs tenant BullMQ queues as well as caches. Queue data has no TTL, so
# an LRU policy silently deletes queued work under pressure — see the comment on
# the redis service in docker-compose.yml. Keep the policy at noeviction and give
# the instance enough memory for your busiest tenant's queue depth instead.
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=noeviction

# DNS provider for wildcard TLS certs (DNS-01 challenge) and Cloudflare DDNS.
# Supported: godaddy (default), cloudflare.
# Tokens are seeded into Forge's DB on first boot; after that manage via Settings UI.
DNS_PROVIDER=godaddy

# GoDaddy API token — format: <KEY>:<SECRET>
# Required for godaddy provider. Create at https://developer.godaddy.com/keys
GODADDY_API_TOKEN=

# Cloudflare API token — needs Zone:DNS:Edit permission.
# Required for cloudflare provider. Zone ID is discovered automatically from DOMAIN.
CLOUDFLARE_API_TOKEN=


# ─── Networking & bind ───────────────────────────────────────────────────────

# Listen address inside the app container.
# PORT=3000
# HOST=0.0.0.0

# Host bind for exposed service ports (PG, Redis, PgBouncer, app).
# Defaults to 127.0.0.1 (locked down — only reachable from localhost).
# Set to 0.0.0.0 if you terminate TLS upstream or have external firewall rules.
# BIND_HOST=127.0.0.1

# Host-side port for the app container (proxied to by Caddy).
# APP_EXTERNAL_PORT=3001

# Host-side ports for the backing services, published on BIND_HOST. These are
# what the world connects to; the in-container ports never change. Keep
# PG_EXTERNAL_PORT and PG_DIRECT_EXTERNAL_PORT in step with the
# PUBLIC_PG_PORT / PUBLIC_PG_DIRECT_PORT values below, which are what Forge
# writes into the connection strings it hands out.
# PG_EXTERNAL_PORT=6432
# PG_DIRECT_EXTERNAL_PORT=5432
# REDIS_EXTERNAL_PORT=6379
# GRAFANA_EXTERNAL_PORT=3002


# ─── Public-facing addresses (shown in generated connection strings) ─────────

PUBLIC_PG_HOST=${DOMAIN}
PUBLIC_PG_PORT=6432                  # PgBouncer — what apps should normally use
PUBLIC_PG_DIRECT_PORT=5432           # Bypasses PgBouncer (needed for pgvector + migrations)

PUBLIC_REDIS_HOST=${DOMAIN}
PUBLIC_REDIS_PORT=6379

PUBLIC_MINIO_HOST=s3.${DOMAIN}


# ─── MinIO ───────────────────────────────────────────────────────────────────

# MinIO root credentials. REQUIRED — compose fails fast (:?) if either is unset;
# the old :-minioadmin defaults were known credentials on every install. Use
# strong random values (openssl rand -base64 32) and keep MINIO_ROOT_USER
# unique per install too (minioadmin is the first guess in every scanner).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-minio-password
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
# MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
# MINIO_USE_SSL=false
# MINIO_BACKUP_BUCKET=pgforge-backups

# Offsite backup target (optional). Any S3-compatible endpoint distinct from
# the same-host MinIO above — a remote MinIO, Backblaze B2, AWS S3, etc.
# `pgforge backup upload` uses this when set; unset falls back to the
# same-host MinIO config above (today's behaviour).
# BACKUP_S3_ENDPOINT=s3.us-west-002.backblazeb2.com
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_USE_SSL=true
# BACKUP_S3_BUCKET=pgforge-backups-offsite
# BACKUP_S3_REGION=

# Nightly backup scheduler (primary-only; off by default so existing installs
# are unaffected). When enabled, backs up every Postgres project and every
# dedicated Redis project once a day at BACKUP_HOUR_UTC, and uploads to
# BACKUP_S3_* (above) when configured. See CLAUDE.md "Scheduled and off-host
# backups".
# BACKUP_SCHEDULE_ENABLED=false
# BACKUP_HOUR_UTC=1  # 0-23 UTC; an out-of-range value fails boot
# BACKUP_RETENTION_DAYS=7


# ─── Docker & app deployment ─────────────────────────────────────────────────

# Host Docker group GID — required so the app container can drive the socket.
# Find with: getent group docker | cut -d: -f3
DOCKER_GID=999

# Docker network name for the pgforge stack.
PGFORGE_NETWORK=pgforge-net

# Path inside the pgforge-app container where Forge clones app git repos.
# APPS_BASE_PATH=/opt/pgforge/apps

# Host path that backs APPS_BASE_PATH. This is a host bind-mount (not a named
# volume) so user-app composes with relative bind mounts (e.g.
# `./config:/etc/foo`) resolve correctly — the Docker daemon evaluates those
# against the host. Override when you want the apps tree on a dedicated data
# disk (e.g. `/mnt/data/pgforge/apps`); otherwise leave at the default.
# APPS_HOST_PATH=/opt/pgforge/apps

# Path inside the pgforge-app container where pg_dump backups land.
# BACKUPS_BASE_PATH=/opt/pgforge/backups

# Refuse to start a new deploy when AppsBasePath has less than this many MB
# free. A heavy compose build can otherwise fill the host disk and PANIC the
# master postgres on its next WAL write. Set to 0 to disable the check.
# DEPLOY_MIN_FREE_MB=3072


# ─── Built-in Docker registry ────────────────────────────────────────────────

# Public hostname (served via Caddy). Apps can push/pull images here without
# needing GHCR/Docker Hub credentials.
REGISTRY_URL=registry.${DOMAIN}
# REGISTRY_INTERNAL_URL=http://pgforge-registry:5000

# Forge API key the deploy code uses to `docker login registry.${DOMAIN}`
# before pulling user-app images. The registry is fronted by Caddy with
# forward_auth → /api/registry/auth, so any valid Forge API key works.
# To populate: log into the Forge UI, create an API key, paste it here, and
# `docker compose up -d app`. Without this every user-app compose that
# references registry.${DOMAIN} requires `docker exec -u forge pgforge-app
# docker login …` per pgforge-app container, which doesn't survive recreates.
# FORGE_REGISTRY_AUTH_KEY=pgf_...


# ─── Caddy admin API ─────────────────────────────────────────────────────────

# Bound to 172.30.0.2:2019 on the internal `caddy-admin` docker network (see
# Caddyfile) — NOT reachable from pgforge-net, so tenant app containers can't
# touch it. This compose default is correct for every install; override only
# if you know what you're doing.
# CADDY_ADMIN_URL=http://172.30.0.2:2019

# Comma-separated proxy subnets whose X-Forwarded-For header the backend
# trusts for client-IP resolution (rate limiting, audit logs). Default:
# 172.31.0.0/24 — the pinned, internal `caddy-proxy` edge network that only
# Caddy and the backend are attached to. Tenant containers sit outside that
# range, so a tenant forging XFF is ignored and rate-limited by its real
# container address. Override ONLY if you re-pin the caddy-proxy ipam subnet
# in docker-compose.yml to match; never widen it to a range that includes
# tenant networks (e.g. 172.16.0.0/12).
# TRUSTED_PROXY_CIDRS=172.31.0.0/24


# ─── Vulnerability scanning ──────────────────────────────────────────────────

# Path or name of the Trivy binary used by the scanning service.
# TRIVY_BIN=trivy

# Scan an app's image after each deploy when its scan policy is "warn" (the
# default policy), recording the result without blocking. Off by default;
# apps set to "block_critical" always scan, before the new containers replace
# the running ones, and "off" apps never do.
# SCAN_ON_DEPLOY=false

# Upper bound for one Trivy run (Go duration).
# SCAN_TIMEOUT=300s


# ─── Kratos (optional) ───────────────────────────────────────────────────────

# Base directory for per-tenant Kratos config files.
# KRATOS_BASE_DIR=/opt/pgforge/kratos


# ─── Static assets (dev only) ────────────────────────────────────────────────

# Override the directory the Go server reads the SPA bundle from.
# In production the SPA is baked into the image at /app/frontend/dist and
# STATIC_DIR is unset.
# STATIC_DIR=/app/frontend/dist

# Override the directory the marketing landing page is served from. Logged-out
# visitors at the apex root "/" get landing/index.html; logged-in users get the
# dashboard SPA. Baked into the image at /app/landing in production; leave unset.
# LANDING_DIR=/app/landing


# ─── GenAI — "Deploy from Git" (optional) ────────────────────────────────────

# The feature enables when both GENAI_BASE_URL and GENAI_API_KEY are set;
# otherwise the /api/git-deploy/* routes are hidden. Works with any
# OpenAI-compatible provider.
#
# Example — OpenAI:
# GENAI_BASE_URL=https://api.openai.com/v1
# GENAI_API_KEY=sk-...
# GENAI_MODEL=gpt-4o
#
# Example — OpenRouter (Kimi K2.6):
# GENAI_BASE_URL=https://openrouter.ai/api/v1
# GENAI_API_KEY=sk-or-v1-...
# GENAI_MODEL=moonshotai/kimi-k2.6
#
# Example — Ollama (local):
# GENAI_BASE_URL=http://host.docker.internal:11434/v1
# GENAI_API_KEY=ollama
# GENAI_MODEL=llama3.1:70b


# ─── SearxNG — self-hosted metasearch (optional) ─────────────────────────────
#
# Enabled when COMPOSE_PROFILES includes "searxng". Apps consume it via
# forge.yaml selectors `searxng.url` and `searxng.api_key`. Caddy fronts
# https://search.${DOMAIN} and rejects any request missing the bearer.
#
# Generate values:
#   SEARXNG_API_KEY     openssl rand -hex 32
#   SEARXNG_SECRET_KEY  openssl rand -hex 32
#
# Both are required when the profile is active; leave blank otherwise.
SEARXNG_API_KEY=
SEARXNG_SECRET_KEY=


# ─── RAG — managed retrieval service (optional) ──────────────────────────────
#
# Enabled when COMPOSE_PROFILES includes "rag". Forge provisions per-instance
# pgvector schemas in a dedicated `forge-rag-pg` container and a per-instance
# MinIO bucket. Apps consume via `rag.<name>.url` / `rag.<name>.api_key` etc.
#
# Required when the profile is active:
#   RAG_PG_PASSWORD     openssl rand -hex 24    (superuser for forge-rag-pg)
#   RAG_GATEWAY_TOKEN   pgl_xxx                 (a Forge-internal LLM gateway
#                                               token used for embedding calls;
#                                               issue via the gateway page)
#
# Connection string the backend uses to reach forge-rag-pg over the docker
# network. Keep in sync with RAG_PG_PASSWORD.
RAG_PG_PASSWORD=
RAG_PG_URL=postgres://forge:${RAG_PG_PASSWORD}@forge-rag-pg:5432/rag?sslmode=disable
RAG_GATEWAY_TOKEN=

# Optional tuning (defaults shown).
RAG_WORKER_CONCURRENCY=2
RAG_MAX_PDF_BYTES=104857600
# RAG_POLL_INTERVAL=30s


# ─── Monitoring — observability stack (optional) ─────────────────────────────
#
# Enabled when COMPOSE_PROFILES includes "monitoring". Brings up Grafana +
# Prometheus + Loki + Grafana Alloy plus exporters. Logs + metrics for both
# Forge and the apps it deploys. Loki stores log chunks in the MinIO bucket
# `forge-logs` (created automatically on first boot). Caddy fronts Grafana on
# https://monitor.${DOMAIN}.
#
# Tracing (Tempo) is a SEPARATE opt-in profile — "monitoring" gives you
# logs + metrics; add "tracing" (COMPOSE_PROFILES=monitoring,tracing) to also
# run Tempo. It's the single heaviest component (~360 MiB), so small/4GB
# installs leave it off and lose only distributed traces.
#
# Grafana admin login. The password defaults to ADMIN_PASSWORD (already set
# above), so the monitoring profile needs no extra secret — log in to Grafana
# with the same credentials as the Forge dashboard. Set GRAFANA_ADMIN_PASSWORD
# only if you want Grafana to have its own distinct password:
#   GRAFANA_ADMIN_PASSWORD   openssl rand -hex 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
#
# Public Grafana URL the Forge dashboard uses to build "View metrics/logs"
# deep links. When unset/empty, the Monitoring nav item and per-app buttons
# are hidden — the app behaves exactly as without monitoring. Leave EMPTY
# unless the monitoring profile is active; then set it to:
#   MONITORING_URL=https://monitor.${DOMAIN}
MONITORING_URL=
#
# Contact URL for security vulnerability reports (served in /.well-known/security.txt,
# RFC 9116). Defaults to the GitHub advisory form. Can be any HTTPS URL (e.g.,
# https://security.example.com or mailto:security@example.com).
SECURITY_CONTACT=https://github.com/fariebee/forge/security/advisories/new
#
# Public landing page at "/" (default false: "/" redirects to /dashboard).
# LANDING_REQUEST_ACCESS_URL is mailto: or https: (empty = the button goes to
# /signup); LANDING_DOCS_URL / LANDING_STATUS_URL likewise, and each link is
# hidden when empty. Footer Terms/Privacy/Report abuse reuse SIGNUP_TERMS_URL,
# SIGNUP_PRIVACY_URL and ABUSE_CONTACT.
LANDING_PAGE_ENABLED=false
LANDING_REQUEST_ACCESS_URL=
LANDING_DOCS_URL=
LANDING_STATUS_URL=
#
# "Move an existing app" card on a new org's Get started checklist. mailto: or
# https: (anything else fails boot); empty hides the card.
ONBOARDING_MIGRATION_URL=
#
# Optional retention (defaults shown). Loki wants a Go duration (hours).
MONITORING_LOGS_RETENTION=336h
MONITORING_METRICS_RETENTION=15d
# Tempo trace retention (Go duration). Traces are high-volume/short-value.
# Only applies when the "tracing" profile is active (Tempo running).
MONITORING_TRACES_RETENTION=72h
#
# Backend OTel metrics. The Go server exposes Prometheus metrics (HTTP RED +
# gateway/RAG business metrics) on a DEDICATED internal listener, bound only on
# pgforge-net and NEVER routed through Caddy — so it can't leak publicly. The
# monitoring profile's Prometheus scrapes it at app:2113. Leave the default.
METRICS_ADDR=:2113
#
# OTLP trace export endpoint. Empty (default) → tracing is a no-op (spans are
# created with zero overhead but shipped nowhere), so non-monitoring installs
# pay nothing. The backend exports over OTLP HTTP, so point it at Alloy's HTTP
# receiver (Alloy forwards to Tempo). Set this only when the "tracing" profile
# is on (Tempo running) to enable distributed tracing — otherwise Alloy has
# nowhere to forward spans:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_EXPORTER_OTLP_ENDPOINT=


# ─── Exposed ports — raw port allocation (optional) ──────────────────────────
#
# Host-port pool for raw port exposure (managed SFTP, etc). Format LOW-HIGH.
# Keep clear of Forge's own infra ports (80, 443, 5432, 6432, 6379, 3001, 3002).
EXPOSED_PORT_RANGE=20000-20999

# ─── Egress SSRF boundary ────────────────────────────────────────────────────
#
# Forge programs DROP rules in the host's DOCKER-USER chain so app containers
# cannot reach cloud instance-metadata endpoints (169.254.169.254 and friends)
# or the host's private networks. This matters because apps fetch
# attacker-influenced URLs — an app POSTing to a merchant-supplied webhook and
# storing the response makes any reachable internal address a readable SSRF
# target, not just a blind one.
#
# On by default and safe for normal installs: docker-internal service discovery
# (postgres, redis, minio, kratos) and the cluster WireGuard mesh are unaffected,
# because the private-range denies are scoped to the WAN interface only.
#
# Set to false ONLY to debug. It removes the boundary for every app on the host.
EGRESS_POLICY_ENABLED=true

# Destinations exempted from the policy, comma-separated. Use when a container
# legitimately must reach a private address (an on-prem database, an internal
# API). A bare address is treated as a /32; IPv4 and IPv6 both accepted. Each
# entry widens the SSRF surface for EVERY app on the host, so keep the list as
# narrow as possible.
#
# This is the supported way to poke a hole. Do NOT hand-edit the FORGE-EGRESS
# iptables chain: Forge owns it exclusively and deletes anything it did not put
# there on the next reconcile.
#
# An entry that cannot be parsed, or that overlaps a cloud metadata endpoint, is
# REFUSED and logged at ERROR — the metadata denies are unconditional. The rest
# of the policy still applies, so a typo here cannot leave the host unprotected.
# EGRESS_ALLOW_CIDRS=192.168.50.10/32,10.20.0.0/24

# TCP destination ports no app container may connect out to over the WAN
# device, comma-separated: 25 stops direct-to-MX spam from a compromised or
# abusive tenant, 3333/4444/5555/14444 are the common crypto-mining pool ports.
# Empty (the default) blocks nothing. Container-to-container traffic on these
# ports is untouched, and EGRESS_ALLOW_CIDRS destinations are exempt too.
# A platform admin can exempt one app (e.g. a first-party mail product) with
# `pgforge apps egress-exempt <id>`, PUT /api/app-projects/{id}/egress-port-exempt
# or the set_app_egress_port_exempt MCP tool — that lifts ONLY this port block,
# never the metadata/private-range denies. Invalid entries are REFUSED and
# logged at ERROR; the rest of the policy still applies.
# EGRESS_BLOCK_PORTS=25,3333,4444,5555,14444

# Per-org usage metering: every minute the primary reads each tenant
# container's cumulative CPU/network counters and memory from the Docker
# Engine API and adds the deltas into hourly per-org rollups (usage_hourly),
# served by GET /api/usage, MCP get_usage and `pgforge usage`. Off by default.
# USAGE_METERING_ENABLED=false

# Managed MariaDB: one mariadb:11.4 container per project, on its own internal
# network (never pgforge-net). Off by default: the /api/mariadb-projects routes
# answer 404 and no MariaDB loop runs.
# MARIADB_ENABLED=false
# Block each project's network takes a /27 from (2048 projects in a /16). Set it
# elsewhere if the host's LAN uses 10.91.0.0/16.
# MARIADB_SUBNET_RANGE=10.91.0.0/16
# Hard cap on one project's InnoDB data, MiB (at least 256). A project outside the
# default org gets the smaller of this and its org's remaining disk quota.
# MARIADB_MAX_SIZE_MB=5120
# Backups one MariaDB project keeps, manual and scheduled together (newest win).
# They stay in the local backup directory (no off-host copy in v1), so size that
# directory for (keep + 1) x (2 x cap + 64 MiB) per project.
# MARIADB_BACKUP_KEEP=7
# Free space (MiB) the backup directory's filesystem must keep beyond one
# backup's worst case (2 x cap + 64 MiB). Below it a MariaDB backup is refused
# (507 for a manual one; a scheduled one is skipped and alerted) and a running
# dump is aborted. Many tenants' backups together can exceed the host disk;
# this is the host-wide bound.
# MARIADB_BACKUP_MIN_FREE_MB=5120

# Sandboxed tenant runtime: every container of an app outside the default org
# (compose services, server-mode apps, static-site builds) runs under this OCI
# runtime. It must already be registered with dockerd — run
# scripts/install-gvisor.sh and verify first (docs/runbooks/gvisor.md), or those
# apps fail at their next deploy. Empty (the default) changes nothing; the
# default org's apps and Forge's own containers never move.
# TENANT_RUNTIME=runsc

# Sandboxed tenant builds: the buildkitd container that builds the images of
# every app outside the default org (compose build: services, server-mode
# apps), under gVisor with CPU/memory caps, instead of the host daemon's own
# BuildKit. Create it first with scripts/install-tenant-builder.sh (after
# install-gvisor.sh) — docs/runbooks/gvisor.md. Empty (the default) changes
# nothing; the default org always builds on the host.
# TENANT_BUILDKIT=forge.tenant-buildkit

# Global cap on concurrent docker builds across all orgs (each org is already
# limited to one build at a time). Default 2.
# BUILD_MAX_CONCURRENT=2

# Managed email for orgs outside the default org: an org with no Resend key of
# its own (Settings -> Email, `pgforge email set`) has its `email.*` bindings
# refused and its Kratos couriers skip the platform key, unless this is true —
# then it falls back to the platform provider. The default org always falls
# back. Default false.
# EMAIL_PLATFORM_RELAY_FOR_TENANTS=false

# Platform email relay via Buzzz. With EMAIL_PLATFORM_RELAY_FOR_TENANTS=true and
# a FULL-permission API key on the platform's own Buzzz organization, those
# orgs no longer get the platform Resend key: their `email.*` bindings and
# Kratos couriers get a per-org relay token for POST /email/v1/emails, which
# Forge forwards to Buzzz only From the org's verified sender domains (Settings
# -> Email, `pgforge email domain-add`) and within its plan's hourly/daily send
# limits. Unset (the default) = the flag behaves exactly as above.
# BUZZZ_API_KEY=bz_...
# BUZZZ_API_URL=https://buzzzmail.co.za

# Per-tenant Buzzz keys (needs both settings above). On the next manifest
# apply, each relay org's apps get a Buzzz SENDING key of their own instead of
# the relay token: scoped to the org's oldest verified sender domain, capped at
# its plan's send limits, and bound as email.api_key / email.smtp_url, with
# email.api_base_url = BUZZZ_API_URL/api/v1. Kratos couriers stay on the relay.
# Requires Buzzz >= 333e1f6 (recipient-counted caps, PATCH, per-key from_name;
# live 2026-09-29): apps talk to Buzzz directly, so its caps count every to/cc/
# bcc address (at most 50 per message) and Forge changes a key's caps and From
# name in place. Default false.
# BUZZZ_TENANT_KEYS=false

# Crypto-mining detection: every minute the primary reads each capped tenant
# app container's CPU counter and cap from the Docker Engine API; a container
# pinned at >=90% of its cap for over 30 minutes gets its app auto-stopped
# via the normal Stop lifecycle, an audit entry (action mining_stop), and an
# operator email (when a managed email provider is configured). Uncapped
# containers are skipped. Off by default — opt in once tenant containers run
# under plan CPU limits and an operator email provider is configured.
# MINING_DETECTION_ENABLED=false

# Operator paging via PagerDuty Events API v2. Second sink on the operator
# alerter, alongside the existing email alerts — mining auto-stop, backup run
# failures, egress boundary DEGRADED/PARTIALLY-active, and cluster
# failover/primary-unreachable/replication_error. Empty (default) sends no
# PagerDuty events, exactly today's behaviour. See docs/runbooks/pagerduty.md
# for setting up the PagerDuty service and escalation policy.
# PAGERDUTY_ROUTING_KEY=

# Distinguishes this node's egress SSRF boundary PagerDuty alerts from its
# cluster siblings (that loop runs on every node, primary and standbys).
# Empty falls back to EffectiveClusterRole (primary/standby); set per node
# on an HA install with more than one standby to fully separate them.
# FORGE_NODE_NAME=

# Dial-level counterpart of EGRESS_ALLOW_CIDRS for requests the Forge server
# process itself makes (webhook delivery, git clone), which never traverse the
# container firewall. Private/loopback targets are denied by default; list
# CIDRs here to exempt legitimate private endpoints (split-horizon DNS,
# on-prem webhook receivers). Invalid entries are ignored and logged at ERROR.
#
# THIS IS THE ESCAPE HATCH FOR A LAN GIT REMOTE. If your apps clone from a
# self-hosted Gitea/GitLab on a private address (https://192.168.1.20/...),
# every git operation Forge runs against it — first provision, redeploy,
# PR preview AND rollback fetch — is denied until that host's CIDR is listed
# here. The failure reads "netguard: blocked by egress policy ...".
# Takes effect on restart (`task deploy`).
# NETGUARD_ALLOW_CIDRS=10.20.0.0/24

# How often the policy is re-asserted. This is load-bearing, not a safety net:
# Docker recreates DOCKER-USER EMPTY on every daemon restart, so this interval
# is the window in which the boundary is down after `systemctl restart docker`.
EGRESS_RECONCILE_INTERVAL=30s


# ─── RevEx billing (optional) ────────────────────────────────────────────────
#
# When BOTH URL and key are set, the primary node polls RevEx and, for every
# org RevEx has a customer for (external_ref == the Forge org UUID; the
# default org is never touched), syncs its plan tier and payment-method gate,
# runs dunning (past-due notice, suspension, optional deletion) and pushes each
# closed month's usage for invoicing. Setup and key scopes:
# docs/billing/revex-api.md. Unset = feature off.
# Setting BOTH goes live on the next deploy: plan sync, the payment gate and
# dunning suspension at day 14. Set DUNNING_SUSPEND_AFTER_DAYS=0 first to go
# live without automatic suspensions.
# REVEX_API_URL=https://revex-api.example.com
# REVEX_API_KEY=rvx_live_...
# REVEX_SYNC_INTERVAL=5m
# Suspend an org this many days after RevEx first reports it past due (0 = never).
# DUNNING_SUSPEND_AFTER_DAYS=14
# Days after a dunning suspension an org is due for deletion. 0 = never (default).
# The operator is emailed DUNNING_DELETE_WARN_DAYS before; nothing is deleted
# unless DUNNING_AUTO_DELETE=true.
# DUNNING_DELETE_AFTER_DAYS=0
# DUNNING_DELETE_WARN_DAYS=7
# DUNNING_AUTO_DELETE=false

# ─── Cluster / high availability (optional) ──────────────────────────────────
#
# Entirely dormant on a single-node install: every cluster loop is gated on
# there being more than one registered node, so leaving this block untouched
# costs nothing. Add nodes with `pgforge node add user@host`.
#
# CLUSTER_ROLE is "primary" on the active node and "standby" on a mirror; a
# standby serves only /api/health and runs no reconcilers, cron, or DDNS.
# CLUSTER_ROLE=primary
#
# The primary's public WireGuard endpoint (ip:port), advertised to standbys.
# Required for the encrypted mesh to form across NAT.
# WG_PUBLIC_ENDPOINT=203.0.113.10:51820
#
# Operator SSH key used by `pgforge node add` to reach the remote host.
# SSH_PRIVATE_KEY_PATH=/root/.ssh/id_ed25519
#
# Replication tuning. Postgres lag above REPL_MAX_LAG_BYTES flags the engine
# as replication_error; the intervals set each sync worker's cadence.
# REPL_MAX_LAG_BYTES=1073741824
# REPL_PG_LAG_INTERVAL=15s
# REPL_CADDY_CERT_INTERVAL=5m
#
# Consecutive unreachable-primary watcher ticks before auto-failover fires
# (~15s per tick, so 8 is roughly two minutes). Auto-failover is opt-in.
# FAILOVER_UNREACHABLE_THRESHOLD=8


# ─── Rarely changed server internals ─────────────────────────────────────────
#
# All of these have working defaults; set them only to override.
#
# Postgres connection used by the server. Compose sets both from the values
# above — override only when pointing Forge at an external database.
# PGBOUNCER_URL=
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
#
# Where RAG reaches Forge's own LLM gateway for embeddings, and the public
# base URL it advertises for query endpoints.
# RAG_GATEWAY_BASE_URL=http://app:3000/llm/v1
# RAG_PUBLIC_BASE_URL=
#
# Docker Compose profiles to activate. Comma-separated; valid values are
# rag, searxng, monitoring, and tracing. Each is off unless listed here.
# COMPOSE_PROFILES=


# ─── CLI-side (informational) ────────────────────────────────────────────────
#
# These are read by the `pgforge` CLI on operator machines, not by the server.
# Included here for completeness.
#
# PGFORGE_SERVER=https://forge.example.com
# PGFORGE_TOKEN=pgf_...
