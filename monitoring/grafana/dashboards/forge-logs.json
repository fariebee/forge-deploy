{
  "uid": "forge-logs",
  "title": "Forge — Logs",
  "tags": ["forge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "query": "label_values(forge_service)", "refId": "service" },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (forge_service) (count_over_time({forge_service=~\"$service\"}[5m]))", "legendFormat": "{{forge_service}}", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error/warn volume",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(count_over_time({job=\"docker\"} |~ \"(?i)error|panic|fatal\"[5m]))", "legendFormat": "errors", "datasource": { "type": "loki", "uid": "loki" } },
        { "refId": "B", "expr": "sum(count_over_time({job=\"docker\"} |~ \"(?i)warn\"[5m]))", "legendFormat": "warns", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Errors (all containers)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{job=\"docker\"} |~ \"(?i)error|panic|fatal\"", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Filtered stream",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        { "refId": "A", "expr": "{forge_service=~\"$service\"} |= \"$search\"", "datasource": { "type": "loki", "uid": "loki" } }
      ]
    }
  ]
}
